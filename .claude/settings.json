{
  "permissions": {
    "allow": [
      "Bash(git push origin auto/*)",
      "Bash(git push -u origin auto/*)",
      "Bash(git push --set-upstream origin auto/*)",
      "Bash(git push origin HEAD:auto/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
